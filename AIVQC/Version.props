<Project>
  <PropertyGroup>
    <!-- Semantic product version shared by every AIVQC project. -->
    <VersionPrefix>0.5.3</VersionPrefix>
    <VersionSuffix>alpha.3</VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).1</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>
</Project>
