# Use the UID/GID of the Synology account that owns deploy/server/data and secrets.
AIVQC_UID=1026
AIVQC_GID=100

# Keep loopback when Synology Reverse Proxy terminates HTTPS on the same NAS.
AIVQC_BIND_ADDRESS=127.0.0.1
AIVQC_PORT=8088

AIVQC_MAX_PACKAGE_BYTES=1073741824
AIVQC_STORAGE_QUOTA_BYTES=5368709120
AIVQC_RETENTION_DAYS=30
