<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aivqc.Production.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Aivqc.Production.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="820"
        Width="1360"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        Icon="/Assets/avalonia-logo.ico"
        Title="AIVQC Production">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="66,*,142,34">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="AI" Foreground="#061411" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="AIVQC" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="PRODUCTION" Classes="eyebrow" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Offline image inspection" FontWeight="SemiBold" />
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="8,0" />
                    <TextBlock Text="ONNX Runtime · CPU" Classes="muted" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="primary" Content="Load package" Click="OnSelectPackageClick" />
                    <Button Classes="secondary" Content="Raw ONNX" Click="OnSelectModelClick" />
                    <Button Classes="secondary" Content="Select image" Click="OnSelectImageClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,380" Margin="22,20,22,14">
            <Border Grid.Column="0" Classes="card" Padding="0" Margin="0,0,10,0" ClipToBounds="True">
                <Grid RowDefinitions="*,Auto">
                    <Border Grid.Row="0" Background="#050912">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <Border Width="72" Height="56" CornerRadius="12"
                                        BorderBrush="#43516A" BorderThickness="2">
                                    <TextBlock Text="◉" FontSize="28" Foreground="#60718B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="INSPECTION IMAGE" Classes="eyebrow" HorizontalAlignment="Center" />
                                <TextBlock Text="Select an image to run the first production inspection"
                                           Classes="muted" />
                            </StackPanel>

                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding HasImage}" />

                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                    Background="#D909101D" CornerRadius="7" Padding="10,6">
                                <TextBlock Text="{Binding ImageResolution}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="28">
                                <StackPanel>
                                    <TextBlock Text="LAST RESULT" Classes="eyebrow" />
                                    <TextBlock Text="{Binding LastResult}" FontSize="20" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TOP CONFIDENCE" Classes="eyebrow" />
                                    <TextBlock Text="{Binding LastConfidence}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="INFERENCE" Classes="eyebrow" />
                                    <TextBlock Text="{Binding LastLatency}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ImageName}" Classes="muted"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="10,0,0,0">
                <StackPanel Spacing="14">
                    <Border Classes="card" Background="{DynamicResource PrimaryMutedBrush}"
                            BorderBrush="#2A7564">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="INSPECTION STATE" Classes="eyebrow" />
                                    <TextBlock Text="{Binding InspectionState}" FontSize="25" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="22" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding InspectionStatusMessage}" Classes="muted"
                                       TextWrapping="Wrap" MinHeight="38" />
                            <Button Classes="primary" Content="{Binding InspectionAction}"
                                    Command="{Binding ToggleInspectionCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Active deployment" FontSize="17" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Classes="secondary" Content="Change package"
                                        Click="OnSelectPackageClick" />
                            </Grid>
                            <TextBlock Text="{Binding PackageSummary}" Classes="muted" FontSize="11"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Input" Classes="muted" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding ModelInput}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{Binding ClassSummary}" Classes="muted"
                                       TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Defect threshold" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ThresholdDisplay}"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                            </Grid>
                            <Slider Minimum="1" Maximum="99" Value="{Binding ConfidenceThreshold}"
                                    IsEnabled="{Binding CanEditThreshold}" />
                            <TextBlock Text="Thresholds are locked by the verified deployment recipe."
                                       Foreground="{DynamicResource PrimaryBrush}" FontSize="11"
                                       IsVisible="{Binding AreThresholdsLocked}" />
                            <TextBlock Text="Any defect at or above this confidence produces NOK."
                                       Classes="muted" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="9">
                            <TextBlock Text="Detected defects" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="No defects above threshold" Classes="muted"
                                       IsVisible="{Binding HasNoDetectedDefects}" />
                            <ItemsControl ItemsSource="{Binding DetectedDefects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="#311625" CornerRadius="6" Padding="9,6" Margin="0,2">
                                            <TextBlock Text="{Binding .}" Foreground="#FF9AAA" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" Margin="22,0,22,14">
            <Border Grid.Column="0" Classes="card" Margin="0,0,7,0">
                <StackPanel Spacing="5">
                    <TextBlock Text="INSPECTED" Classes="eyebrow" />
                    <TextBlock Text="{Binding InspectedCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Current session" Classes="muted" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="7,0">
                <StackPanel Spacing="5">
                    <TextBlock Text="OK" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OkCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OkPercentage}" Classes="muted" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="7,0">
                <StackPanel Spacing="5">
                    <TextBlock Text="NOK" Foreground="#FF7A86" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NokCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NokPercentage}" Classes="muted" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" Margin="7,0">
                <StackPanel Spacing="5">
                    <TextBlock Text="ERRORS" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ErrorCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Inference failures" Classes="muted" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" Margin="7,0,0,0">
                <StackPanel Spacing="5">
                    <TextBlock Text="SOURCE" Classes="eyebrow" />
                    <TextBlock Text="Image" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Camera integration next" Classes="muted" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Offline mode · ONNX inference runs locally"
                           Classes="muted" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding VersionDisplay}" Classes="muted"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
